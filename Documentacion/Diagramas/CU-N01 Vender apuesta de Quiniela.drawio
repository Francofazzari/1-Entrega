enta."' style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="378.0" y="136.0" width="192.0" height="42" as="geometry"/></mxCell><mxCell id="v4" value="Validar cada jugada con las reglas&lt;br&gt;del juego (ValidarJugada)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="79.0" y="212.0" width="190.0" height="42" as="geometry"/></mxCell><mxCell id="v5" value="¿Todas las jugadas son&lt;br&gt;válidas?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="83.5" y="283.0" width="181.0" height="54" as="geometry"/></mxCell><mxCell id="v6" value="Error con el motivo (monto, cifras,&lt;br&gt;posición, cantidad o rango de&lt;br&gt;números)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="379.5" y="282.0" width="189.0" height="56" as="geometry"/></mxCell><mxCell id="v7" value="¿El juego se sortea por&lt;br&gt;lotería y turno?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="85.5" y="366.0" width="177.0" height="54" as="geometry"/></mxCell><mxCell id="v8" value="Por cada lotería × turno elegidos:&lt;br&gt;ObtenerParaVender (crea el sorteo&lt;br&gt;del día si no existe)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="76.0" y="448.0" width="196.0" height="56" as="geometry"/></mxCell><mxCell id="v9" value="Un único sorteo: el del día del juego,&lt;br&gt;sin lotería ni turno" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="374.5" y="455.0" width="199.0" height="42" as="geometry"/></mxCell><mxCell id="v10" value="" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="156.0" y="532.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="v11" value="¿Todos los sorteos&lt;br&gt;están abiertos?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="94.5" y="596.0" width="159.0" height="54" as="geometry"/></mxCell><mxCell id="v12" value='Error: "El sorteo … ya no acepta&lt;br&gt;apuestas (está …)."' style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="383.0" y="602.0" width="182.0" height="42" as="geometry"/></mxCell><mxCell id="v13" value="Crear la Apuesta: CodigoTicket =&lt;br&gt;Guid.NewGuid(), FechaHora =&lt;br&gt;ahora, Estado = Vigente" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="81.5" y="678.0" width="185.0" height="56" as="geometry"/></mxCell><mxCell id="v14" value="Por cada sorteo y cada plantilla agregar una&lt;br&gt;Jugada (Quiniela: con tipo y posición; demás&lt;br&gt;juegos: con el precio del juego y los números con&lt;br&gt;ceros a la izquierda)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="762.0" width="260" height="70" as="geometry"/></mxCell><mxCell id="v15" value="Total = suma de los montos de las&lt;b