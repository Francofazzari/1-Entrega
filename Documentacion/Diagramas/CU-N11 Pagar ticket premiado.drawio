ght="894" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v47" value="Diagrama de flujo CU-N11 - PremioBLL.Calcular (premio de cada jugada del ticket)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=494.0;height=24;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fillColor=none;swimlaneFillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="665.0" height="854.0" as="geometry"/></mxCell><mxCell id="v1" value="Inicio: Calcular(a) — por cada jugada j del ticket" style="rounded;rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40.0" y="68.0" width="288.0" height="34" as="geometry"/></mxCell><mxCell id="v2" value="¿El sorteo de j está&lt;br&gt;Sorteado?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="105.0" y="130.0" width="158.0" height="54" as="geometry"/></mxCell><mxCell id="v3" value='Detalle = "Todavía no se sorteó";&lt;br&gt;importe 0' style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="402.0" y="136.0" width="184.0" height="42" as="geometry"/></mxCell><mxCell id="v4" value="Leer los números ganadores del&lt;br&gt;sorteo (una vez por sorteo)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="93.5" y="212.0" width="181.0" height="42" as="geometry"/></mxCell><mxCell id="v5" value="¿El juego se juega a una posición&lt;br&gt;(Quiniela)?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="59.0" y="282.0" width="250" height="54" as="geometry"/></mxCell><mxCell id="v6" value="¿Es redoblona?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="109.0" y="366.0" width="150" height="50" as="geometry"/></mxCell><mxCell id="v7" value="Aciertos = números de j que salieron; importe =&lt;br&gt;monto × tabla de aciertos del juego" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="359.0" y="288.0" width="270" height="42" as="geometry"/></mxCell><mxCell id="v8" value='El número "sale" si un ganador hasta&lt;br&gt;su posición termina con sus cifras' style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="82.5" y="446.0" width="203.0" height="42" as="geometry"/></mxCell><mxCell id="v9" value="¿Salió?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="109.0" y="516.0" width="150" height="50" as="geometry"/></mxCell><mxCell id="v10" value="Importe = monto × (7, 70, 600 o&lt;br&gt;3.500 según las cifras) ÷ posición" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="90.5" y="594.0" width="187.0" height="42" as="geometry"/></mxCell><mxCell id="v11" value='Detalle "El NN no salió …"; importe 0' style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="393.5" y="522.0" width="201.0" height="38" as="geometry"/></mxCell><mxCell id="v12" value="¿Salieron los dos&lt;br&gt;números?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="419.0" y="364.0" width="150" height="54" as="geometry"/></mxCell><mxCell id="v13" value="Importe = monto × 70 ÷ posición del 1° × 70 ÷&lt;br&gt;posición del 2°" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="359.0" y="446.0" width="270" height="42" as="geometry"/></mxCell><mxCell id="v14" value="" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="166.0" y="664.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="v15" value="Redondear el importe a 2 decimales&lt;br&gt;y agregar el Premio" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="85.0" y="728.0" width="198.0" height="42" as="geometry"/></mxCell><mxCell id="v16" value="Fin: lista de premios (uno por jugada)" style="rounded;rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="66.0" y="798.0" width="236.0" height="34" as="geometry"/></mxCell><mxCell id="e17" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2D3E50;endArrow=open;endFill=0;endSize=9;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="" style="html=1;edgeSt