<mxfile host="app.diagrams.net" agent="Documentacion Agencia de Quiniela" version="24.7.17"><diagram id="p100" name="uc CU-N09 Cargar resultado de sorteo"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1006" pageHeight="366" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v5" value="uc CU-N09 Cargar resultado de sorteo" style="shape=umlFrame;whiteSpace=wrap;html=1;width=245.0;height=24;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fillColor=none;swimlaneFillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="966" height="326" as="geometry"/></mxCell><mxCell id="v1" value="Sistema Agencia de Quiniela" style="html=1;whiteSpace=wrap;fillColor=#F6F9FC;strokeColor=#1F4E79;verticalAlign=top;align=center;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1F4E79;spacingTop=8;rounded=0;container=0;" vertex="1" parent="1"><mxGeometry x="220" y="50" width="420" height="250" as="geometry"/></mxCell><mxCell id="act_adm" value="Administrador" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=15;fontStyle=1;fontColor=#1F2937;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="140" width="34" height="64" as="geometry"/></mxCell><mxCell id="uc_cu" value="&lt;b&gt;CU-N09&lt;/b&gt;&lt;br&gt;Cargar resultado de sorteo" style="ellipse;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=15;fontColor=#1F2937;perimeter=ellipsePerimeter;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="290" y="140" width="280" height="70" as="geometry"/></mxCell><mxCell id="e2" value="" style="html=1;edgeStyle=none;rounded=0;strokeColor=#2D3E50;fontFamily=Helvetica;fontSize=13;fontColor=#1F4E79;labelBackgroundColor=#FFFFFF;fontStyle=2;endArrow=none;endFill=0;endSize=10;exitX=1;exitY=0.5;exitPerimeter=0;" edge="1" parent="1" source="act_adm" target="uc_cu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v3" value="Solo el perfil Administrador (RN-17). Se&lt;br&gt;inicia con «Cargar resultado» en la&lt;br&gt;pestaña «Números ganadores» de&lt;br&gt;Reportes, que se habilita cuando se&lt;br&gt;eligió un único sorteo, sin sortear y de&lt;br&gt;una fecha que no es futura." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#F4F6F9;strokeColor=#8A99AD;fontFamily=Helvetica;fontSize=13;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="260" height="120" as="geometry"/></mxCell><mxCell id="e4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#8A99AD;edgeStyle=none;" edge="1" parent="1" target="uc_cu"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="190.0" as="sourcePoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p101" name="Diagrama de flujo CU-N09 - SorteoBLL.CompletarResultado (validar y completar el resultado)"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="692" pageHeight="870" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v41" value="Diagrama de flujo CU-N09 - SorteoBLL.CompletarResultado (validar y completar el resultado)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=557.0;height=24;boundedLbl=1;verticalAlign=middle;align=left;spacingLeft=8;fillColor=none;swimlaneFillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="652" height="830.0" as="geometry"/></mxCell><mxCell id="v1" value="Inicio: CompletarResultado(juego, cargados)" style="rounded;rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="47.0" y="68.0" width="274.0" height="34" as="geometry"/></mxCell><mxCell id="v2" value="¿Hay un texto por cada número que sale&lt;br&gt;en el sorteo?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="59.0" y="130.0" width="250" height="54" as="geometry"/></mxCell><mxCell id="v3" value='Error: "En … salen N números por&lt;br&gt;sorteo."' style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="398.5" y="136.0" width="191.0" height="42" as="geometry"/></mxCell><mxCell id="v4" value="Por cada puesto con texto: validar&lt;br&gt;que sean solo dígitos, dentro del&lt;br&gt;rango del juego" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="89.0" y="212.0" width="190.0" height="56" as="geometry"/></mxCell><mxCell id="v5" value="¿Algún número no es&lt;br&gt;válido?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="100.0" y="296.0" width="168.0" height="54" as="geometry"/></mxCell><mxCell id="v6" value='Error: "El número del puesto N (X)&lt;br&gt;no es válido: van del … al …"' style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="399.0" y="302.0" width="190.0" height="42" as="geometry"/></mxCell><mxCell id="v7" value="¿Algún número está&lt;br&gt;repetido?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="103.0" y="378.0" width="162.0" height="54" as="geometry"/></mxCell><mxCell id="v8" value='Error: "El número … está repetido."' style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="396.5" y="386.0" width="195.0" height="38" as="geometry"/></mxCell><mxCell id="v9" value="¿El juego se juega a una posición&lt;br&gt;(Quiniela)?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#EAF1F8;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="59.0" y="460.0" width="250" height="54" as="geometry"/></mxCell><mxCell id="v10" value="terminaciones = últimas 2 cifras de&lt;br&gt;los números cargados" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="398.0" y="466.0" width="192.0" height="42" as="geometry"/></mxCell><mxCell id="v11" value="" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="166.0" y="542.0" width="36" height="36" as="geometry"/></mxCell><mxCell id="v12" value="Por cada puesto vacío: sortear un número al azar&lt;br&gt;(Azar.Entre) hasta que no esté usado ni termine en&lt;br&gt;una de las terminaciones" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="44.0" y="606.0" width="280" height="56" as="geometry"/></mxCell><mxCell id="v13" value="Formatear cada número con ceros a&lt;br&gt;la izquierda y asignarle su posición&lt;br&gt;(1, 2, 3...)" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;rounded=0;" vertex="1" parent="1"><mxGeometry x="82.5" y="690.0" width="203.0" height="56" as="geometry"/></mxCell><mxCell id="v14" value="Fin: devuelve los números ganadores" style="rounded;rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="66.5" y="774.0" width="235.0" height="34" as="geometry"/></mxCell><mxCell id="v15" value="Fin con error: no se guarda nada" style="rounded;rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#1F4E79;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="389.5" y="774.0" width="209.0" height="34" as="geometry"/></mxCell><mxCell id="e16" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2D3E50;endArrow=open;endFill=0;endSize=9;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="v1" target="v2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2D3E50;endArrow=open;endFill=0;endSize=9;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;dashed=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="v2" target="v3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l18" value="No" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F4E79;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e17"><mxGeometry x="-0.6201" relative="1" as="geometry"><mxPoint x="0" y="-10" as="offset"/></mxGeometry></mxCell><mxCell id="e19" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounde