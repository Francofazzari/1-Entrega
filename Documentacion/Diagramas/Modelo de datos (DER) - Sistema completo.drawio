Fill=0;startArrow=ERzeroToOne;endArrow=ERmandOne;startSize=12;endSize=12;jumpStyle=arc;jumpSize=8;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.4313;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="tbl_PAGOS" target="tbl_APUESTAS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e399" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2D3E50;endFill=0;startFill=0;startArrow=ERoneToMany;endArrow=ERmandOne;startSize=12;endSize=12;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.4396;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="tbl_JUGADAS" target="tbl_APUESTAS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e400" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2D3E50;endFill=0;startFill=0;startArrow=ERoneToMany;endArrow=ERmandOne;startSize=12;endSize=12;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3791;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="tbl_JUGADA_NUMERO" target="tbl_JUGADAS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e401" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2D3E50;endFill=0;startFill=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startSize=12;endSize=12;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="tbl_JUGADAS" target="tbl_SORTEOS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e402" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2D3E50;endFill=0;startFill=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startSize=12;endSize=12;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3625;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="tbl_NUMERO_GANADOR" target="tbl_SORTEOS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e403" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2D3E50;endFill=0;startFill=0;startArrow=ERzeroToMany;endArrow=ERmandOne;startSize=12;endSize=12;jumpStyle=arc;jumpSize=8;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2963;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="tbl_SORTEOS" target="tbl_JUEGOS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e404" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2D3E50;endFill=0;startFill=0;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startSize=12;endSize=12;jumpStyle=arc;jumpSize=8;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="tbl_SORTEOS" target="tbl_LOTERIAS"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e405" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2D3E50;endFill=0;startFill=0;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startSize=12;endSize=12;jumpStyle=arc;jumpSize=8;exitX=0.6667;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="tbl_SORTEOS" target="tbl_TURNOS"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="482.7" y="1195.0"/><mxPoint x="793.5" y="1195.0"/></Array></mxGeometry></mxCell><mxCell id="v406" value="APUESTAS es el ticket: una fila por ticket, con su código, quién lo vendió, la fecha y hora, el total y&lt;br&gt;el estado (Vigente, Pagada o Anulada).&lt;br&gt;JUGADAS son los renglones del ticket: una fila por jugada, con el sorteo al que va, el tipo, si es&lt;br&gt;automática, el monto y el orden. Los números de cada jugada están en JUGADA_NUMERO.&lt;br&gt;Van en tablas separadas porque un ticket tiene varias jugadas, cada una de un sorteo distinto:&lt;br&gt;juntas, los datos del ticket se repetirían en cada jugada." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#F4F6F9;strokeColor=#8A99AD;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1381.0" y="620" width="528.0" height="102" as="geometry"/></mxCell><mxCell id="v407" value="SORTEOS es el sorteo de un día: juego + lotería + turno + fecha, combinación que no se repite&lt;br&gt;(UQ_SORTEOS). El sorteo de mañana es otra fila, que el sistema crea la primera vez que se&lt;br&gt;necesita. Lo que no cambia de un día a otro está en JUEGOS, LOTERIAS y TURNOS." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#F4F6F9;strokeColor=#8A99AD;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1381.0" y="738" width="528.0" height="60" as="geometry"/></mxCell><mxCell id="v408" value="Ejemplo: el 20/10/2026 se juega el 23 a la cabeza por $500 en Provincia y en La Ciudad, turno&lt;br&gt;Nocturna. Queda 1 fila en APUESTAS (total $1.000) y 2 en JUGADAS, una para cada sorteo del día&lt;br&gt;(Provincia-Nocturna y La Ciudad-Nocturna), cada una con su número 23 en JUGADA_NUMERO.&lt;br&gt;Si gana, el cobro queda en PAGOS." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#F4F6F9;strokeColor=#8A99AD;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1381.0" y="814" width="528.0" height="74" as="geometry"/></mxCell><mxCell id="v409" value="Seguridad: PERMISO_PERMISO arma el árbol de familias y patentes de PERMISOS y&lt;br&gt;USUARIO_PERMISO asigna los permisos a cada usuario. Auditoría: Bitacora y&lt;br&gt;CAMBIOS_USUARIO guardan una copia de los datos del usuario, sin clave foránea. Multi-idioma:&lt;br&gt;TRADUCCIONES tiene el texto de cada palabra en cada idioma; IDIOMAS.DigitoVerificador e&lt;br&gt;IDIOMAS_DIGITO_VERTICAL controlan la integridad de IDIOMAS." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#F4F6F9;strokeColor=#8A99AD;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1381.0" y="904" width="528.0" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>