alue="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2D3E50;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endArrow=open;endFill=0;endSize=10;startArrow=none;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.6667;entryY=1.0000;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="cls_Premio" target="cls_Jugada"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4747.5" y="1910.0"/><mxPoint x="4336.5" y="1910.0"/></Array></mxGeometry></mxCell><mxCell id="l473" value="+Jugada 1" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fontStyle=0;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e472"><mxGeometry x="0.9335" relative="1" as="geometry"><mxPoint x="31.5" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="l474" value="0..1" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;fontStyle=0;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e472"><mxGeometry x="-0.9335" relative="1" as="geometry"><mxPoint x="-15.0" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="v475" value="Cómo se lee: cada columna es un módulo y cada paquete una capa de la solución. La pantalla (UI) usa su clase de negocio (BLL), que usa su acceso a datos (DAL); todas&lt;br&gt;trabajan con las entidades (BE). Las flechas sin rótulo de la UI a la BLL y de la BLL a la DAL son atributos privados de la clase (bll, dal, …), de multiplicidad 1. Arriba de cada&lt;br&gt;pantalla están las ventanas que abre («create»). Se muestran los miembros públicos de cada clase.&lt;br&gt;Para que se lea, no se dibujan: el uso de SesionManager (usuario de la sesión) y de Estilos (colores, fuentes y controles) desde las pantallas; el de BitacoraBLL, que figura&lt;br&gt;como atributo bitacora; el de Conexion y Mapeo desde la DAL; las pantallas que abre el menú FormPrincipal; y el de las entidades BE desde las demás capas." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#F4F6F9;strokeColor=#8A99AD;fontFamily=Helvetica;fontSize=11;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="2514" width="900" height="88" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>