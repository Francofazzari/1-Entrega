  <diagram id="dominio" name="Diagrama de Dominio">
    <mxGraphModel dx="1649" dy="653" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
