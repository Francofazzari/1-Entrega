<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Base de datos del sistema. Para usar otra maquina o instancia, cambiar solo esta linea. -->
        <add name="AgenciaQuiniela"
             connectionString="Server=.;Database=AgenciaQuiniela;Integrated Security=True;"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>